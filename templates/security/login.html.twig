{% extends 'base.html.twig' %}
{% block title %}Connexion — PIXARA{% endblock %}

{% block body %}
<div class="auth-split">

    <div class="auth-panel">
        <div class="panel-inner">
            <div class="brand">
                <span class="brand-dot"></span>
                <span class="brand-name">PIXARA</span>
            </div>
            <p class="panel-tagline">Bon retour parmi nous.<br>Vos créations vous attendent.</p>
            <div class="pins">
                <div class="pin-col">
                    <div class="pin" style="height:130px;background:rgba(124,58,237,.22)"></div>
                    <div class="pin" style="height:88px;background:rgba(124,58,237,.14)"></div>
                    <div class="pin" style="height:158px;background:rgba(124,58,237,.18)"></div>
                </div>
                <div class="pin-col" style="margin-top:30px">
                    <div class="pin" style="height:112px;background:rgba(124,58,237,.16)"></div>
                    <div class="pin" style="height:148px;background:rgba(124,58,237,.26)"></div>
                    <div class="pin" style="height:96px;background:rgba(124,58,237,.12)"></div>
                </div>
                <div class="pin-col">
                    <div class="pin" style="height:152px;background:rgba(124,58,237,.19)"></div>
                    <div class="pin" style="height:104px;background:rgba(124,58,237,.23)"></div>
                    <div class="pin" style="height:132px;background:rgba(124,58,237,.15)"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="auth-form-panel">
        <div class="auth-card">

            {% if error %}
                <div class="flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <h2 class="card-title">Connexion</h2>
            <p class="card-sub">Content de vous revoir sur PIXARA</p>

            <form method="post" action="{{ path('app_login') }}" class="aform">

                <div class="fgroup">
                    <label for="inputEmail">Email</label>
                    <div class="iwrap">
                        <svg class="iico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        <input type="email" id="inputEmail" name="_username" class="ainput"
                               value="{{ last_username }}" placeholder="votre@email.com"
                               autocomplete="email" required autofocus>
                    </div>
                </div>

                <div class="fgroup">
                    <label for="inputPassword">Mot de passe</label>
                    <div class="iwrap">
                        <svg class="iico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        <input type="password" id="inputPassword" name="_password" class="ainput"
                               placeholder="Votre mot de passe" autocomplete="current-password" required>
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="abtn">Se connecter</button>

            </form>

            <p class="aswitch">Pas encore de compte ? <a href="{{ path('app_register') }}">Inscrivez-vous</a></p>
        </div>
    </div>

</div>
{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@700;900&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;background:#F8FAFC;color:#0F172A;min-height:100vh}

.auth-split{display:flex;min-height:100vh}

.auth-panel{width:42%;background:linear-gradient(160deg,#0F0A2E 0%,#1E1060 100%);display:flex;align-items:center;justify-content:center;padding:60px 40px;overflow:hidden;position:relative}
.auth-panel::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 70% 30%,rgba(124,58,237,.08) 0%,transparent 60%)}
.panel-inner{width:100%;position:relative;z-index:1}
.brand{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.brand-dot{width:11px;height:11px;border-radius:50%;background:#7C3AED;box-shadow:0 0 0 4px rgba(124,58,237,.25);flex-shrink:0}
.brand-name{font-size:1.9rem;font-weight:900;color:#fff;letter-spacing:.12em;font-family:'Poppins',sans-serif}
.panel-tagline{color:rgba(255,255,255,.55);font-size:.98rem;line-height:1.85;margin-bottom:44px}
.pins{display:flex;gap:10px}
.pin-col{flex:1;display:flex;flex-direction:column;gap:10px}
.pin{border-radius:14px}

.auth-form-panel{flex:1;display:flex;align-items:center;justify-content:center;padding:40px 24px;overflow-y:auto}
.auth-card{width:100%;max-width:420px}
.card-title{font-size:1.7rem;font-weight:800;color:#0F172A;margin-bottom:6px}
.card-sub{color:#64748B;font-size:.93rem;margin-bottom:30px}

.flash-error{background:#FEF2F2;color:#EF4444;border:1px solid #FECACA;padding:12px 16px;border-radius:10px;margin-bottom:20px;font-size:.88rem;font-weight:500}

.fgroup{margin-bottom:16px}
.fgroup label{display:block;font-size:.82rem;font-weight:600;color:#374151;margin-bottom:6px}
.iwrap{position:relative}
.iico{position:absolute;left:13px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:#94A3B8;pointer-events:none}
.ainput{width:100%;padding:12px 14px 12px 40px;border:1.5px solid #E2E8F0;border-radius:10px;font-size:.93rem;background:#F8FAFC;color:#0F172A;outline:none;transition:border-color .2s,box-shadow .2s,background .2s;font-family:inherit}
.ainput::placeholder{color:#CBD5E1}
.ainput:focus{border-color:#7C3AED;background:#fff;box-shadow:0 0 0 3px rgba(124,58,237,.13)}

.abtn{width:100%;padding:13px;border:none;border-radius:10px;background:linear-gradient(135deg,#78c8eb,#7C3AED);color:#fff;font-size:.97rem;font-weight:700;cursor:pointer;transition:transform .2s,box-shadow .2s;margin-top:4px;font-family:inherit}
.abtn:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(124,58,237,.38)}
.abtn:active{transform:translateY(0)}

.aswitch{text-align:center;margin-top:20px;font-size:.88rem;color:#64748B}
.aswitch a{color:#7C3AED;font-weight:600;text-decoration:none}
.aswitch a:hover{text-decoration:underline}

@media(max-width:768px){
    .auth-panel{display:none}
    .auth-form-panel{padding:30px 16px}
}
</style>
{% endblock %}
