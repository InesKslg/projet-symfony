{% extends 'base.html.twig' %}
{% block title %}Mes Photos — PIXARA{% endblock %}

{% block body %}

{{ include('product/_notifications.html.twig') }}
{{ include('product/_header.html.twig') }}

{{ include('product/_tab_private.html.twig') }}
{{ include('product/_tab_public.html.twig') }}

{{ include('product/_tab_albums.html.twig') }}
{{ include('product/_modals.html.twig') }}

{% endblock %}

{% block javascripts %}
<script>
const allThemes = [{% for theme in themes %}{id:{{ theme.id }},nom:"{{ theme.nom }}"},{% endfor %}];
const allThemeNames = allThemes.map(t => t.nom);

function normalize(s) {
    return (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
}

function filterTab(tabId, query, msgId) {
    const q = normalize(query);
    const items = document.querySelectorAll(`#${tabId} .gallery .media-item`);
    let found = false;
    items.forEach(item => {
        const themes = (item.dataset.theme || '').split(',').map(t => normalize(t)).filter(Boolean);
        const visible = !q || themes.some(t => t.includes(q));
        item.style.display = visible ? '' : 'none';
        if (visible) found = true;
    });
    document.querySelectorAll(`#${tabId} .theme-pill`).forEach(b => b.classList.remove('active'));
    document.querySelector(`#${tabId} .theme-pill[data-theme="all"]`)?.classList.add('active');
    if (msgId) {
        const themeKnown = q && allThemeNames.some(n => normalize(n).includes(q));
        document.getElementById(msgId).style.display = (q && !found && !themeKnown) ? 'block' : 'none';
    }
}

function dismissNotif(btn, id) {
    fetch(`/notification/read/${id}`, { method: 'GET' });
    const item = btn.closest('.notif-item');
    item.style.animation = 'notifOut .25s ease forwards';
    setTimeout(() => {
        item.remove();
        if (!document.querySelector('.notif-item')) {
            const stack = document.getElementById('notif-stack');
            if (stack) stack.remove();
        }
    }, 250);
}

document.addEventListener('DOMContentLoaded', () => {

    /* MULTI-SELECTION STATE */
    const selectState = {
        photosTab: { mode: false, ids: new Set() },
        publicPhotosTab: { mode: false, ids: new Set() }
    };
    let currentSelectTab = null;

    function toggleSelectItem(tabId, item) {
        const id = item.dataset.photoId;
        if (!id) return;
        const state = selectState[tabId];
        const cb = item.querySelector('.sel-checkbox');
        if (state.ids.has(id)) {
            state.ids.delete(id);
            item.classList.remove('selected');
            if (cb) cb.checked = false;
        } else {
            state.ids.add(id);
            item.classList.add('selected');
            if (cb) cb.checked = true;
        }
        document.getElementById('selFloatCount').textContent = state.ids.size;
    }

    function enterSelectMode(tabId) {
        currentSelectTab = tabId;
        selectState[tabId].mode = true;
        selectState[tabId].ids.clear();
        document.querySelectorAll(`#${tabId} .media-item`).forEach(i => i.classList.remove('selected'));
        document.querySelectorAll(`#${tabId} .sel-checkbox`).forEach(cb => cb.checked = false);
        document.getElementById(tabId).classList.add('select-mode');
        document.getElementById('selFloatCount').textContent = '0';
        document.getElementById('selFloatAlbumRow').style.display = 'none';
        document.getElementById('selFloatBar').style.display = 'flex';
        document.querySelector(`.select-toggle-btn[data-tab="${tabId}"]`)?.classList.add('active');
    }

    function exitSelectMode(tabId) {
        currentSelectTab = null;
        selectState[tabId].mode = false;
        selectState[tabId].ids.clear();
        document.querySelectorAll(`#${tabId} .media-item`).forEach(i => i.classList.remove('selected'));
        document.querySelectorAll(`#${tabId} .sel-checkbox`).forEach(cb => cb.checked = false);
        document.getElementById(tabId).classList.remove('select-mode');
        document.getElementById('selFloatBar').style.display = 'none';
        document.getElementById('selFloatAlbumRow').style.display = 'none';
        document.querySelector(`.select-toggle-btn[data-tab="${tabId}"]`)?.classList.remove('active');
    }

    /* PHOTO DETAILS */
    document.querySelectorAll('.toggle-info').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const parent = btn.closest('.media-item');
            if (!parent) return;
            const tabId = btn.closest('.tab-content')?.id;
            if (tabId && selectState[tabId]?.mode) { toggleSelectItem(tabId, parent); return; }

            const description = parent.querySelector('.photo-desc')?.innerText || '';
            const formActionEdit = parent.querySelector('form[action*="edit"]')?.action || '';
            const formActionDelete = parent.querySelector('form[action*="delete"]')?.action || '';

            const localisation = parent.querySelector('.photo-info p:nth-child(2)')?.innerText.replace('Localisation : ', '') || 'Non renseignée';
            const datePrise = parent.querySelector('.photo-info p:nth-child(3)')?.innerText.replace('Date : ', '') || 'Non renseignée';
            const theme = parent.querySelector('.photo-info p:nth-child(4)')?.innerText.replace('Thème : ', '') || '';
            const isPublic = parent.querySelector('input[name="public"]')?.checked || false;
            const statut = isPublic ? 'Public' : 'Privé';

            const currentThemeNames = (parent.dataset.theme || '').split(',').filter(Boolean);
            const themesHtml = allThemes.length ? `
                <div class="edit-themes-wrap" style="margin-top:10px">
                    <span class="edit-themes-label">Thèmes :</span>
                    <div class="edit-themes-list">${allThemes.map(t =>
                        `<label class="edit-theme-cb"><input type="checkbox" name="theme_ids[]" value="${t.id}"${currentThemeNames.includes(t.nom.toLowerCase()) ? ' checked' : ''}> ${t.nom}</label>`
                    ).join('')}</div>
                </div>` : '';

            const container = document.getElementById('photoDetailContainer');
            container.innerHTML = `
                <div class="detail-info">
                    <p><strong>Description :</strong> ${description}</p>
                    <p><strong>Localisation :</strong> ${localisation}</p>
                    <p><strong>Date :</strong> ${datePrise}</p>
                    <p><strong>Thème :</strong> ${theme}</p>
                    <p><strong>Statut :</strong> ${statut}</p>
                </div>
                <form action="${formActionEdit}" method="POST" class="mform" style="margin-top:14px">
                    <input type="text" name="description" value="${description}" required class="minput">
                    <label class="mcheck"><input type="checkbox" name="public" ${isPublic ? 'checked' : ''}> Photo publique</label>
                    ${themesHtml}
                    <button type="submit" class="mbtn">Enregistrer</button>
                </form>
                <form action="${formActionDelete}" method="POST" onsubmit="return confirm('Supprimer cette photo ?');" style="margin-top:8px">
                    <button type="submit" class="mbtn mbtn-danger">Supprimer</button>
                </form>
            `;
            document.getElementById('photoDetailModal').style.display = 'flex';
        });
    });

    document.getElementById('closePhotoDetailModal')?.addEventListener('click', () => {
        document.getElementById('photoDetailModal').style.display = 'none';
    });

    /* ALBUM PHOTOS MODAL */
    const albumPhotosModal = document.getElementById('viewAlbumModal');
    document.getElementById('closeAlbumPhotosModal')?.addEventListener('click', () => {
        albumPhotosModal.style.display = 'none';
    });

    document.addEventListener('click', (e) => {
        if (e.target.classList.contains('view-album-photos-btn')) {
            const albumId = e.target.dataset.albumId;
            const container = document.getElementById('albumPhotosContainer');
            const title = document.getElementById('modalAlbumTitle');
            albumPhotosModal.style.display = 'flex';
            container.innerHTML = '<p style="color:#94A3B8;text-align:center;padding:20px">Chargement…</p>';

            fetch(`/album/${albumId}/json`)
                .then(res => res.json())
                .then(data => {
                    title.textContent = `Album : ${data.albumName}`;
                    container.innerHTML = '';
                    if (!data.photos || data.photos.length === 0) {
                        container.innerHTML = '<p style="color:#94A3B8;text-align:center;padding:20px">Aucune photo</p>';
                        return;
                    }
                    data.photos.forEach(photo => {
                        const div = document.createElement('div');
                        div.classList.add('media-item');
                        div.innerHTML = `
                            <div class="mi-img"><img src="/uploads/photos/${photo.photoUrl}" loading="lazy"></div>
                            <p class="photo-desc">${photo.description ?? ''}</p>
                            <form action="/photo/${photo.id}/delete" method="POST" onsubmit="return confirm('Supprimer cette photo ?');" style="padding:6px 10px">
                                <button type="submit" class="abtn-sm abtn-danger" style="width:100%">Supprimer</button>
                            </form>
                        `;
                        container.appendChild(div);
                    });
                })
                .catch(() => { container.innerHTML = '<p style="color:#EF4444;text-align:center">Erreur de chargement</p>'; });
        }
    });

    /* GÉRER ALBUM */
    const manageAlbumModal = document.getElementById('manageAlbumModal');
    const allUserPhotos = [
        {% for photo in privatePhotos %}
        { id: {{ photo.id }}, url: "{{ photo.photoUrl }}", description: {{ photo.description|json_encode|raw }}, themes: "{{ photo.themes|map(t => t.nom)|join(', ') }}" },
        {% endfor %}
        {% for photo in publicPhotos %}
        { id: {{ photo.id }}, url: "{{ photo.photoUrl }}", description: {{ photo.description|json_encode|raw }}, themes: "{{ photo.themes|map(t => t.nom)|join(', ') }}" },
        {% endfor %}
    ];

    document.addEventListener('click', (e) => {
        if (!e.target.classList.contains('manage-album-btn')) return;
        const albumId = e.target.dataset.albumId;
        const albumName = e.target.dataset.albumName;
        manageAlbumModal.style.display = 'flex';
        const renameForm = document.getElementById('renameAlbumForm');
        renameForm.action = `/album/${albumId}/edit`;
        document.getElementById('renameAlbumInput').value = albumName;
        document.getElementById('manageAlbumInfos').innerHTML = '<p style="color:#94A3B8;font-size:.85rem">Chargement…</p>';

        fetch(`/album/${albumId}/json`)
            .then(res => res.json())
            .then(data => {
                const albumPhotoIds = (data.photos || []).map(p => p.id);
                document.getElementById('manageAlbumInfos').innerHTML = `
                    <p><strong>Nom :</strong> ${data.albumName}</p>
                    <p><strong>Nombre de photos :</strong> ${albumPhotoIds.length}</p>
                `;
            })
            .catch(() => { document.getElementById('manageAlbumInfos').innerHTML = '<p style="color:#EF4444;font-size:.85rem">Erreur de chargement.</p>'; });
    });

    document.getElementById('closeManageAlbumModal')?.addEventListener('click', () => {
        manageAlbumModal.style.display = 'none';
    });

    /* MODALS OUVERTURE */
    const addMediaModal = document.getElementById('addMediaModal');
    const themeRequestModal = document.getElementById('themeRequestModal');

    document.getElementById('addMediaBtn')?.addEventListener('click', () => addMediaModal.style.display = 'flex');
    document.getElementById('requestThemeBtn')?.addEventListener('click', () => themeRequestModal.style.display = 'flex');
    document.getElementById('closeModal')?.addEventListener('click', () => addMediaModal.style.display = 'none');
    document.getElementById('closeThemeModal')?.addEventListener('click', () => themeRequestModal.style.display = 'none');

    /* TABS */
    document.querySelectorAll('.tab-btn').forEach(tab => {
        tab.addEventListener('click', () => {
            exitSelectMode('photosTab');
            exitSelectMode('publicPhotosTab');
            document.querySelectorAll('.tab-btn').forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            const target = tab.dataset.tab;
            document.querySelectorAll('.tab-content').forEach(tc => {
                tc.style.display = tc.id === target ? 'block' : 'none';
            });
        });
    });

    /* FILTER THEME */
    document.querySelectorAll('.theme-pill').forEach(btn => {
        btn.addEventListener('click', () => {
            const parent = btn.closest('.tab-content');
            if (!parent) return;
            const theme = btn.dataset.theme;
            parent.querySelectorAll('.theme-pill').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            parent.querySelectorAll('.gallery .media-item').forEach(item => {
                const itemThemes = item.dataset.theme.split(',').map(t => t.trim()).filter(Boolean);
                item.style.display = (theme === 'all' || itemThemes.includes(theme)) ? 'block' : 'none';
            });
            btn.closest('.theme-more-dropdown')?.closest('.theme-more-wrap')
                ?.querySelector('.theme-more-dropdown')?.classList.remove('open');
        });
    });

    /* THEME MORE DROPDOWN */
    document.querySelectorAll('.theme-more-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const dropdown = btn.nextElementSibling;
            const isOpen = dropdown.classList.contains('open');
            document.querySelectorAll('.theme-more-dropdown.open').forEach(d => d.classList.remove('open'));
            if (!isOpen) dropdown.classList.add('open');
        });
    });
    document.addEventListener('click', () => {
        document.querySelectorAll('.theme-more-dropdown.open').forEach(d => d.classList.remove('open'));
    });

    /* FERMER MODALS EN CLIQUANT EN DEHORS */
    document.querySelectorAll('.modal').forEach(modal => {
        modal.addEventListener('click', (e) => {
            if (e.target === modal) modal.style.display = 'none';
        });
    });

    /* ACTIVE TAB DEPUIS URL (?tab=albums) */
    const urlTab = new URLSearchParams(window.location.search).get('tab');
    if (urlTab) {
        const target = urlTab + 'Tab';
        const tabBtn = document.querySelector(`.tab-btn[data-tab="${target}"]`);
        if (tabBtn) tabBtn.click();
    }

    /* UPLOAD PHOTO AJAX */
    document.getElementById('addMediaForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;
        const errorDiv = document.getElementById('uploadError');
        const btn = form.querySelector('button[type="submit"]');
        errorDiv.style.display = 'none';
        errorDiv.textContent = '';
        btn.disabled = true;
        btn.textContent = 'Envoi…';

        try {
            const resp = await fetch(form.action, {
                method: 'POST',
                body: new FormData(form),
                headers: { 'X-Fetch-Request': '1' }
            });
            const data = await resp.json();
            if (data.success) {
                addMediaModal.style.display = 'none';
                form.reset();
                window.location.reload();
            } else {
                errorDiv.textContent = data.error ?? 'Erreur lors de l\'envoi.';
                errorDiv.style.display = 'block';
                btn.disabled = false;
                btn.textContent = 'Publier';
            }
        } catch {
            errorDiv.textContent = 'Erreur réseau.';
            errorDiv.style.display = 'block';
            btn.disabled = false;
            btn.textContent = 'Publier';
        }
    });

    /* SELECTION HANDLERS */
    document.querySelectorAll('.select-toggle-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const tabId = btn.dataset.tab;
            if (selectState[tabId].mode) exitSelectMode(tabId); else enterSelectMode(tabId);
        });
    });

    document.querySelectorAll('#photosTab .media-item, #publicPhotosTab .media-item').forEach(item => {
        item.addEventListener('click', () => {
            const tabId = item.closest('.tab-content')?.id;
            if (tabId && selectState[tabId]?.mode) toggleSelectItem(tabId, item);
        });
    });

    document.getElementById('selFloatCancel')?.addEventListener('click', () => {
        if (currentSelectTab) exitSelectMode(currentSelectTab);
    });

    document.getElementById('selFloatAlbumToggle')?.addEventListener('click', () => {
        const row = document.getElementById('selFloatAlbumRow');
        row.style.display = row.style.display === 'none' ? 'flex' : 'none';
    });

    document.getElementById('selFloatDelete')?.addEventListener('click', async () => {
        if (!currentSelectTab) return;
        const ids = [...selectState[currentSelectTab].ids];
        if (!ids.length) return;
        if (!confirm(`Supprimer ${ids.length} photo(s) ?`)) return;
        const btn = document.getElementById('selFloatDelete');
        btn.disabled = true;
        try {
            const resp = await fetch('/photos/bulk-delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ photo_ids: ids.map(Number) })
            });
            const data = await resp.json();
            if (data.success) {
                const tab = currentSelectTab;
                ids.forEach(id => document.querySelector(`#${tab} .media-item[data-photo-id="${id}"]`)?.remove());
                exitSelectMode(tab);
            }
        } catch { alert('Erreur réseau.'); }
        finally { btn.disabled = false; }
    });

    document.getElementById('selFloatAlbumConfirm')?.addEventListener('click', async () => {
        if (!currentSelectTab) return;
        const ids = [...selectState[currentSelectTab].ids];
        const albumId = document.getElementById('selFloatAlbumSelect').value;
        if (!ids.length) { alert('Sélectionnez des photos.'); return; }
        if (!albumId) { alert('Choisissez un album.'); return; }
        const btn = document.getElementById('selFloatAlbumConfirm');
        btn.disabled = true;
        try {
            const form = new FormData();
            ids.forEach(id => form.append('photo_ids[]', id));
            const resp = await fetch(`/album/${albumId}/add-photo`, {
                method: 'POST', headers: { 'X-Fetch-Request': '1' }, body: form
            });
            if (resp.ok) { exitSelectMode(currentSelectTab); window.location.reload(); }
        } catch { alert('Erreur réseau.'); }
        finally { btn.disabled = false; }
    });

    /* CREATION ALBUM INLINE */
    const albumNewCard  = document.getElementById('albumNewCard');
    const albumNewIdle  = document.getElementById('albumNewIdle');
    const albumNewForm  = document.getElementById('albumNewForm');
    const albumNewInput = document.getElementById('albumNewInput');
    const albumNewError = document.getElementById('albumNewError');

    function showAlbumCreate() {
        albumNewIdle.style.display = 'none';
        albumNewForm.style.display = 'flex';
        albumNewInput.value = '';
        albumNewError.style.display = 'none';
        albumNewInput.focus();
    }
    function hideAlbumCreate() {
        albumNewForm.style.display = 'none';
        albumNewIdle.style.display = 'flex';
    }

    albumNewIdle?.addEventListener('click', showAlbumCreate);
    document.getElementById('albumNewCancel')?.addEventListener('click', hideAlbumCreate);

    async function submitAlbumCreate() {
        const name = albumNewInput.value.trim();
        if (!name) { albumNewError.textContent = 'Nom requis.'; albumNewError.style.display = 'block'; return; }
        albumNewError.style.display = 'none';
        const btn = document.getElementById('albumNewSubmit');
        btn.disabled = true; btn.textContent = 'Création…';
        try {
            const form = new FormData();
            form.append('categorie', name);
            const resp = await fetch('/album/quick-create', { method: 'POST', body: form });
            const data = await resp.json();
            if (data.success) {
                const grid = document.querySelector('.albums-grid');
                const card = document.createElement('div');
                card.className = 'album-card';
                card.id = 'album-card-' + data.albumId;
                card.innerHTML = `
                    <div class="album-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M3 9h18M9 21V9"/></svg></div>
                    <p class="album-name">${data.categorie}</p>
                    <div class="album-actions">
                        <a href="/album/${data.albumId}/view" class="abtn-sm" style="text-align:center;text-decoration:none;display:block">Voir photos</a>
                        <button class="manage-album-btn abtn-sm abtn-outline" data-album-id="${data.albumId}" data-album-name="${data.categorie}">Gérer</button>
                    </div>`;
                albumNewCard.insertAdjacentElement('afterend', card);
                const opt1 = new Option(data.categorie, data.albumId);
                const opt2 = new Option(data.categorie, data.albumId);
                document.getElementById('selFloatAlbumSelect')?.appendChild(opt1);
                hideAlbumCreate();
            } else {
                albumNewError.textContent = data.error || 'Erreur.';
                albumNewError.style.display = 'block';
            }
        } catch { albumNewError.textContent = 'Erreur réseau.'; albumNewError.style.display = 'block'; }
        finally { btn.disabled = false; btn.textContent = 'Créer'; }
    }

    document.getElementById('albumNewSubmit')?.addEventListener('click', submitAlbumCreate);
    albumNewInput?.addEventListener('keydown', e => { if (e.key === 'Enter') submitAlbumCreate(); });

    /* DEMANDE DE THEME AJAX */
    document.getElementById('themeRequestForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;
        const errorDiv = document.getElementById('themeError');
        errorDiv.textContent = '';
        const btn = form.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.textContent = 'Envoi…';
        try {
            const res = await fetch('/theme/request/ajax', { method: 'POST', body: new FormData(form) });
            const json = await res.json();
            if (json.success) {
                themeRequestModal.style.display = 'none';
                form.reset();
                alert(json.message);
            } else {
                errorDiv.textContent = json.message ?? 'Erreur.';
            }
        } catch {
            errorDiv.textContent = 'Erreur réseau.';
        } finally {
            btn.disabled = false;
            btn.textContent = 'Envoyer';
        }
    });

});
</script>
{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@700;900&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;background:#EEF2FF;color:#0F172A}

/* HEADER */
.app-header{position:fixed;top:0;left:0;right:0;height:64px;background:#fff;display:flex;align-items:center;gap:16px;padding:0 24px;box-shadow:0 1px 20px rgba(15,23,42,.06);z-index:1000}
.logo{font-size:1.4rem;font-weight:900;color:#7C3AED;letter-spacing:.1em;font-family:'Poppins',sans-serif;flex-shrink:0;display:flex;align-items:center;gap:8px}
.logo-dot{width:9px;height:9px;background:#7C3AED;border-radius:50%;box-shadow:0 0 8px rgba(124,58,237,.5);flex-shrink:0}
.header-center{flex:1}
.welcome-text{font-size:.88rem;color:#64748B}
.welcome-text strong{color:#0F172A;font-weight:700}
.header-actions{display:flex;align-items:center;gap:8px;flex-shrink:0}

.hbtn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border:none;border-radius:8px;font-size:.83rem;font-weight:600;cursor:pointer;transition:all .2s;background:#F1F5F9;color:#374151;font-family:inherit;text-decoration:none;white-space:nowrap}
.hbtn svg{width:14px;height:14px}
.hbtn:hover{background:#E2E8F0}
.hbtn-primary{background:linear-gradient(135deg,#78c8eb,#7C3AED);color:#fff}
.hbtn-primary:hover{box-shadow:0 4px 14px rgba(124,58,237,.35);background:linear-gradient(135deg,#78c8eb,#7C3AED)}
.hbtn-danger{background:#FEF2F2;color:#EF4444}
.hbtn-danger:hover{background:#EF4444;color:#fff}

/* TABS */
.tabs-bar{display:flex;gap:6px;justify-content:center;padding:80px 24px 16px;flex-wrap:wrap}
.tab-btn{padding:8px 20px;border:none;border-radius:50px;font-size:.85rem;font-weight:500;cursor:pointer;background:#fff;color:#64748B;border:1.5px solid #E2E8F0;transition:all .2s;font-family:inherit}
.tab-btn:hover{border-color:#7C3AED;color:#7C3AED}
.tab-btn.active{background:linear-gradient(135deg,#78c8eb,#7C3AED);color:#fff;border-color:transparent;font-weight:600}

/* TOOLBAR + SEARCH */
.tab-toolbar{display:flex;align-items:center;padding:16px 24px 4px;gap:10px}
.tab-search-wrap{flex:1;display:flex;justify-content:center}
.tab-search-bar{display:flex;align-items:center;background:#F8FAFC;border:1.5px solid #E2E8F0;border-radius:50px;padding:0 16px;max-width:480px;width:100%;transition:border-color .2s,box-shadow .2s}
.tab-search-bar:focus-within{border-color:#7C3AED;box-shadow:0 0 0 3px rgba(124,58,237,.12)}
.tab-search-bar svg{width:15px;height:15px;color:#94A3B8;flex-shrink:0}
.tab-search-bar input{flex:1;border:none;background:transparent;outline:none;padding:10px 10px;font-size:.88rem;color:#0F172A;font-family:inherit}
.tab-search-bar input::placeholder{color:#CBD5E1}

/* THEMES ROW */
.themes-row{display:flex;gap:8px;flex-wrap:wrap;align-items:center;padding:12px 24px}
.theme-pill{padding:7px 18px;border-radius:50px;border:1.5px solid #E2E8F0;background:#fff;font-size:.82rem;font-weight:500;color:#374151;cursor:pointer;transition:all .22s;font-family:inherit}
.theme-pill:hover{border-color:#7C3AED;color:#7C3AED;transform:translateY(-1px);box-shadow:0 4px 12px rgba(124,58,237,.12)}
.theme-pill.active{background:linear-gradient(135deg,#78c8eb,#7C3AED);color:#fff;border-color:transparent;box-shadow:0 4px 14px rgba(124,58,237,.3)}

/* Featured top-4 pills */
.theme-pill-featured{
    background:linear-gradient(#fff,#fff) padding-box,
               linear-gradient(135deg,#78c8eb,#7C3AED) border-box;
    border:1.5px solid transparent;
    color:#5B21B6;font-weight:600;
    display:inline-flex;align-items:center;gap:7px;
    box-shadow:0 2px 10px rgba(124,58,237,.1)
}
.theme-pill-featured:hover{
    background:linear-gradient(135deg,#78c8eb,#7C3AED);
    color:#fff;border-color:transparent;
    box-shadow:0 6px 18px rgba(124,58,237,.3);transform:translateY(-2px)
}
.theme-pill-featured.active{
    background:linear-gradient(135deg,#78c8eb,#7C3AED);
    color:#fff;border-color:transparent;
    box-shadow:0 6px 18px rgba(124,58,237,.3)
}
.pill-count{font-size:.68rem;background:rgba(124,58,237,.1);color:#7C3AED;padding:2px 8px;border-radius:50px;font-weight:700;transition:background .2s,color .2s;line-height:1.4}
.theme-pill-featured:hover .pill-count,.theme-pill-featured.active .pill-count{background:rgba(255,255,255,.25);color:#fff}

/* More dropdown */
.theme-more-wrap{position:relative}
.theme-more-btn{padding:7px 13px;border-radius:50px;border:1.5px dashed #C4B5FD;background:#F5F3FF;font-size:.78rem;font-weight:700;color:#7C3AED;cursor:pointer;transition:all .2s;font-family:inherit;display:flex;align-items:center;gap:4px}
.theme-more-btn:hover{border-color:#7C3AED;background:#EDE9FE;transform:translateY(-1px)}
.theme-more-arrow{font-size:.62rem}
.theme-more-dropdown{position:absolute;top:calc(100% + 8px);left:0;z-index:200;background:#fff;border:1.5px solid #E2E8F0;border-radius:16px;padding:12px;box-shadow:0 12px 32px rgba(15,23,42,.12);min-width:190px;display:none;flex-wrap:wrap;gap:7px}
.theme-more-dropdown.open{display:flex}
.theme-more-dropdown .theme-pill{font-size:.78rem;padding:6px 14px}

/* GALLERY MASONRY */
.gallery{columns:4 180px;column-gap:14px;padding:8px 24px 60px}
.media-item{break-inside:avoid;margin-bottom:14px;background:#fff;border-radius:14px;overflow:hidden;box-shadow:0 2px 10px rgba(15,23,42,.07);transition:transform .25s,box-shadow .25s;display:block;position:relative}
.media-item:hover{transform:translateY(-3px);box-shadow:0 10px 28px rgba(15,23,42,.11)}
.mi-img{position:relative;overflow:hidden}
.media-item img{width:100%;height:auto;display:block;min-height:60px;transition:transform .3s}
.media-item:hover img{transform:scale(1.04)}
.mi-hover{position:absolute;inset:0;background:rgba(15,23,42,.45);opacity:0;transition:opacity .25s;display:flex;align-items:center;justify-content:center}
.media-item:hover .mi-hover{opacity:1}
.mi-view-btn{padding:8px 18px;border:2px solid #fff;border-radius:50px;background:transparent;color:#fff;font-size:.82rem;font-weight:600;cursor:pointer;transition:all .2s;font-family:inherit}
.mi-view-btn:hover{background:#fff;color:#0F172A}
.badge-private{position:absolute;top:8px;left:8px;background:#EF4444;color:#fff;padding:2px 8px;border-radius:50px;font-size:.72rem;font-weight:600}
.photo-desc{padding:8px 12px;font-size:.82rem;color:#374151;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.photo-info{display:none}
.edit-themes-wrap{margin:8px 0 6px}
.edit-themes-label{font-size:.78rem;font-weight:600;color:#64748B;text-transform:uppercase;letter-spacing:.05em;display:block;margin-bottom:4px}
.edit-themes-list{display:flex;flex-wrap:wrap;gap:6px}
.edit-theme-cb{display:flex;align-items:center;gap:5px;font-size:.8rem;color:#374151;background:#F8FAFC;border:1px solid #E2E8F0;border-radius:20px;padding:4px 10px;cursor:pointer;transition:all .2s}
.edit-theme-cb:has(input:checked){background:#EEF2FF;border-color:#7C3AED;color:#7C3AED;font-weight:600}
.edit-theme-cb input{accent-color:#7C3AED;width:13px;height:13px}

/* ALBUMS */
.albums-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px;padding:8px 24px 60px}
.album-card{background:#fff;border-radius:14px;padding:20px 16px;box-shadow:0 2px 10px rgba(15,23,42,.07);text-align:center;transition:transform .25s,box-shadow .25s}
.album-card:hover{transform:translateY(-3px);box-shadow:0 10px 28px rgba(15,23,42,.11)}
.album-icon{width:52px;height:52px;background:linear-gradient(135deg,rgba(124,58,237,.12),rgba(96,165,250,.1));border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 10px}
.album-icon svg{width:24px;height:24px;color:#7C3AED}
.album-name{font-size:.95rem;font-weight:700;color:#0F172A;margin-bottom:12px}
.album-actions{display:flex;flex-direction:column;gap:6px}
.abtn-sm{padding:6px 10px;border:none;border-radius:8px;font-size:.78rem;font-weight:600;cursor:pointer;transition:all .2s;font-family:inherit;background:#F1F5F9;color:#374151}
.abtn-sm:hover{background:#E2E8F0}
.abtn-outline{background:transparent;border:1.5px solid #7C3AED;color:#7C3AED}
.abtn-outline:hover{background:#7C3AED;color:#fff}
.abtn-danger{background:#FEF2F2;color:#EF4444}
.abtn-danger:hover{background:#EF4444;color:#fff}

.empty-state{text-align:center;padding:80px 24px;color:#94A3B8}
.empty-ico{width:56px;height:56px;margin:0 auto 12px}
.empty-state p{font-size:.95rem}

/* MODAL */
.modal{display:none;position:fixed;inset:0;background:rgba(15,23,42,.5);backdrop-filter:blur(4px);justify-content:center;align-items:center;z-index:9999;padding:16px}
.modal-card{background:#fff;border-radius:20px;width:100%;max-width:420px;padding:28px 24px;position:relative;box-shadow:0 20px 50px rgba(15,23,42,.2);animation:mfade .25s ease;max-height:90vh;overflow-y:auto}
.modal-card-wide{max-width:580px}
.modal-title{font-size:1.1rem;font-weight:700;color:#0F172A;margin-bottom:20px}
.modal-close{position:absolute;top:14px;right:14px;width:30px;height:30px;border-radius:50%;border:none;background:#F1F5F9;color:#64748B;font-size:.9rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s}
.modal-close:hover{background:#E2E8F0;color:#0F172A}

.mform{display:flex;flex-direction:column;gap:10px}
.mlabel{font-size:.82rem;font-weight:600;color:#374151}
.minput{padding:10px 14px;border:1.5px solid #E2E8F0;border-radius:10px;font-size:.9rem;background:#F8FAFC;color:#0F172A;outline:none;transition:border-color .2s,box-shadow .2s;font-family:inherit;width:100%}
.minput:focus{border-color:#7C3AED;background:#fff;box-shadow:0 0 0 3px rgba(124,58,237,.12)}
.mtextarea{min-height:90px;resize:vertical}
.mcheck{display:flex;align-items:center;gap:8px;font-size:.85rem;color:#374151;cursor:pointer}
.merror{color:#EF4444;font-size:.85rem;margin-bottom:6px}
.mdivider{border:none;border-top:1px solid #F1F5F9;margin:14px 0}

.mbtn{padding:11px 18px;border:none;border-radius:10px;background:linear-gradient(135deg,#78c8eb,#7C3AED);color:#fff;font-size:.9rem;font-weight:700;cursor:pointer;transition:transform .2s,box-shadow .2s;font-family:inherit;width:100%}
.mbtn:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(124,58,237,.35)}
.mbtn-danger{background:linear-gradient(135deg,#EF4444,#DC2626)}
.mbtn-danger:hover{box-shadow:0 6px 18px rgba(239,68,68,.35)}

.detail-info{background:#F8FAFC;border-radius:10px;padding:14px;font-size:.85rem;line-height:1.8;color:#374151;margin-bottom:4px}
.detail-info strong{color:#0F172A}

.album-photos-container{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px;max-height:60vh;overflow-y:auto;padding:4px}
.album-photos-list{display:flex;flex-wrap:wrap;gap:10px;max-height:260px;overflow-y:auto;padding:4px 0}
.album-infos{background:#F8FAFC;border-radius:10px;padding:12px;font-size:.85rem;color:#374151;line-height:1.7;margin-bottom:14px}
.album-infos strong{color:#0F172A}

/* SELECTION MODE */
.select-toggle-btn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border:1.5px solid #7C3AED;background:transparent;color:#7C3AED;border-radius:10px;font-size:.82rem;font-weight:600;cursor:pointer;font-family:inherit;transition:all .2s;white-space:nowrap;flex-shrink:0}
.select-toggle-btn svg{width:14px;height:14px}
.select-toggle-btn:hover,.select-toggle-btn.active{background:#7C3AED;color:#fff}
.sel-checkbox-wrap{position:absolute;top:8px;left:8px;z-index:10;display:none;width:22px;height:22px;align-items:center;justify-content:center;background:rgba(255,255,255,.9);border-radius:6px;cursor:pointer;padding:2px}
.sel-checkbox{width:16px;height:16px;cursor:pointer;accent-color:#7C3AED;margin:0}
.select-mode .sel-checkbox-wrap{display:flex}
.media-item.selected{outline:3px solid #7C3AED;outline-offset:-2px}
.media-item.selected .sel-checkbox-wrap{display:flex}

/* FLOATING SELECTION BAR */
.sel-float-bar{position:fixed;bottom:0;left:0;right:0;background:rgba(10,15,30,.96);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);padding:14px 28px 22px;display:none;flex-direction:column;gap:12px;z-index:3000;border-top:1px solid rgba(255,255,255,.08);box-shadow:0 -10px 40px rgba(0,0,0,.3);animation:slideUpBar .22s cubic-bezier(.4,0,.2,1)}
@keyframes slideUpBar{from{transform:translateY(100%);opacity:0}to{transform:translateY(0);opacity:1}}
.sel-float-top{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.sel-float-info{display:flex;align-items:center;gap:10px;flex:1;min-width:0}
.sel-float-count{background:linear-gradient(135deg,#78c8eb,#7C3AED);color:#fff;font-weight:800;font-size:1rem;padding:4px 13px;border-radius:50px;min-width:32px;text-align:center;flex-shrink:0}
.sel-float-label{color:rgba(255,255,255,.55);font-size:.83rem;font-weight:500}
.sel-float-actions{display:flex;align-items:center;gap:8px;flex-shrink:0}
.sel-float-album-toggle{display:inline-flex;align-items:center;gap:7px;padding:9px 16px;background:rgba(124,58,237,.2);border:1.5px solid rgba(124,58,237,.5);color:#C4B5FD;border-radius:12px;font-size:.82rem;font-weight:600;cursor:pointer;font-family:inherit;transition:all .2s}
.sel-float-album-toggle:hover{background:rgba(124,58,237,.4);color:#fff}
.sel-float-album-toggle svg{width:15px;height:15px}
.sel-float-delete{display:inline-flex;align-items:center;gap:7px;padding:9px 16px;background:rgba(239,68,68,.18);border:1.5px solid rgba(239,68,68,.4);color:#FCA5A5;border-radius:12px;font-size:.82rem;font-weight:600;cursor:pointer;font-family:inherit;transition:all .2s}
.sel-float-delete:hover{background:rgba(239,68,68,.38);color:#fff}
.sel-float-delete svg{width:14px;height:14px}
.sel-float-cancel{width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.5);font-size:.9rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;flex-shrink:0;font-family:inherit}
.sel-float-cancel:hover{background:rgba(255,255,255,.18);color:#fff}
.sel-float-album-row{display:none;gap:10px;align-items:center;padding-top:10px;border-top:1px solid rgba(255,255,255,.07)}
.sel-float-album-row select{flex:1;padding:9px 14px;background:rgba(255,255,255,.07);border:1.5px solid rgba(255,255,255,.13);color:#fff;border-radius:12px;font-family:inherit;font-size:.85rem;outline:none;cursor:pointer}
.sel-float-album-row select option{background:#1E293B;color:#fff}
.sel-float-album-row select:focus{border-color:#7C3AED}
.sel-float-album-row #selFloatAlbumConfirm{display:inline-flex;align-items:center;gap:6px;padding:9px 18px;background:linear-gradient(135deg,#78c8eb,#7C3AED);color:#fff;border:none;border-radius:12px;font-size:.83rem;font-weight:700;cursor:pointer;font-family:inherit;transition:transform .15s,box-shadow .15s;flex-shrink:0}
.sel-float-album-row #selFloatAlbumConfirm:hover{transform:translateY(-1px);box-shadow:0 4px 14px rgba(124,58,237,.4)}
.sel-float-album-row #selFloatAlbumConfirm svg{width:14px;height:14px}

/* ALBUM NEW CARD */
.album-new-card{border:2px dashed #D1D5DB;background:transparent;box-shadow:none;transition:border-color .25s,background .25s;cursor:pointer;padding:0}
.album-new-card:hover{border-color:#7C3AED;background:rgba(124,58,237,.04);box-shadow:none;transform:none}
.album-new-idle{width:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:24px 16px;border:none;background:transparent;cursor:pointer;font-family:inherit}
.album-new-plus{width:52px;height:52px;background:linear-gradient(135deg,rgba(124,58,237,.1),rgba(96,165,250,.1));border-radius:14px;display:flex;align-items:center;justify-content:center;transition:all .25s}
.album-new-card:hover .album-new-plus{background:linear-gradient(135deg,rgba(124,58,237,.2),rgba(96,165,250,.18))}
.album-new-plus svg{width:24px;height:24px;color:#7C3AED}
.album-new-idle span{font-size:.9rem;font-weight:700;color:#7C3AED}
.album-new-form{display:flex;flex-direction:column;padding:20px 16px;width:100%}
.gallery{padding-bottom:90px}

@keyframes mfade{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}

/* NOTIFICATIONS */
#notif-stack{position:fixed;top:80px;right:20px;z-index:9998;display:flex;flex-direction:column;gap:10px;max-width:340px}
.notif-item{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid #E2E8F0;border-left:4px solid #7C3AED;border-radius:12px;padding:12px 14px;box-shadow:0 4px 20px rgba(15,23,42,.12);animation:notifIn .3s ease}
.notif-icon{flex-shrink:0;width:32px;height:32px;background:rgba(124,58,237,.1);border-radius:8px;display:flex;align-items:center;justify-content:center}
.notif-icon svg{width:16px;height:16px;color:#7C3AED}
.notif-msg{flex:1;font-size:.84rem;color:#1E293B;line-height:1.4;font-weight:500}
.notif-close{flex-shrink:0;width:24px;height:24px;border:none;background:#F1F5F9;border-radius:50%;font-size:.75rem;color:#64748B;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s}
.notif-close:hover{background:#E2E8F0;color:#0F172A}
@keyframes notifIn{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:translateX(0)}}
@keyframes notifOut{from{opacity:1;transform:translateX(0)}to{opacity:0;transform:translateX(20px)}}

@media(max-width:768px){
    .gallery{columns:2 140px}
    .header-actions{gap:5px}
    .hbtn{padding:6px 10px;font-size:.78rem}
    .albums-grid{grid-template-columns:repeat(auto-fill,minmax(140px,1fr))}
}
@media(max-width:480px){
    .gallery{columns:1}
    .app-header{flex-wrap:wrap;height:auto;padding:10px 16px;gap:8px}
    .tabs-bar{padding-top:110px}
}
</style>
{% endblock %}
