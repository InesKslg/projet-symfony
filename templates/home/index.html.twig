{% extends 'base.html.twig' %}
{% block title %}PIXARA — Galerie photo{% endblock %}

{% block body %}

<header class="site-header">
    <div class="logo"><span class="logo-dot"></span>PIXARA</div>
    <div class="header-search-wrap">
        <div class="search-bar">
            <svg class="search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="searchTheme" placeholder="Rechercher un thème…">
            <button id="searchBtn">Rechercher</button>
        </div>
        <p id="searchMessage">Thème introuvable</p>
    </div>
    <nav class="header-nav">
        <a href="{{ path('app_register') }}" class="nav-btn nav-primary">S'inscrire</a>
        <a href="{{ path('app_login') }}" class="nav-btn nav-outline">Connexion</a>
    </nav>
</header>

<div class="themes-bar">
    <button class="theme-pill active" data-theme="all">Tous</button>
    {% for theme in recentThemes %}
        <button class="theme-pill" data-theme="{{ theme.id }}">
            {{ theme.nom }}
        </button>
    {% endfor %}
</div>

<div id="photo-grid">
    {% for item in defaultPhotos %}
        <div class="photo-card" data-theme="{{ item.themeId }}">
            <div class="photo-wrapper">
                <img src="{{ asset('uploads/photos/' ~ item.photo.photoUrl) }}" alt="{{ item.photo.description }}" loading="lazy">
                <div class="overlay">
                    <p>{{ item.photo.description }}</p>
                </div>
            </div>
            <div class="photo-caption">
                <p class="caption-desc">{{ item.photo.description }}</p>
                <span class="caption-author">{{ item.photo.userPhoto ? item.photo.userPhoto.userIdentifier : 'Inconnu' }}</span>
            </div>
            <div class="photo-info" style="display:none;">
                <p><strong>Description :</strong> {{ item.photo.description }}</p>
                <p><strong>Posté par :</strong> {{ item.photo.userPhoto ? item.photo.userPhoto.userIdentifier : 'Inconnu' }}</p>
                <p><strong>Localisation :</strong> {{ item.photo.localisation ?: 'Non renseignée' }}</p>
                <p><strong>Date :</strong>
                    {% if item.photo.datePrise %}
                        {{ item.photo.datePrise|date('d/m/Y') }}
                    {% else %}
                        Non renseignée
                    {% endif %}
                </p>
            </div>
            <button class="toggle-info">Voir détails</button>
        </div>
    {% endfor %}
</div>

<div id="pagination"></div>

<script>
const photosPerPage = 15
let currentPage = 1
let currentTheme = "all"

const allPhotos = Array.from(document.querySelectorAll(".photo-card"))
const paginationDiv = document.getElementById("pagination")
const themeButtons = Array.from(document.querySelectorAll(".theme-pill"))
const searchInput = document.getElementById("searchTheme")
const searchMessage = document.getElementById("searchMessage")
const searchBtn = document.getElementById("searchBtn")

function showPhotos(){
    const filteredPhotos = allPhotos.filter(p =>
        currentTheme==="all" || p.dataset.theme===currentTheme
    )
    const totalPages = Math.ceil(filteredPhotos.length/photosPerPage)
    const start = (currentPage-1)*photosPerPage
    const end = start+photosPerPage
    allPhotos.forEach(p=>p.style.display="none")
    filteredPhotos.slice(start,end).forEach(p=>p.style.display="block")
    paginationDiv.innerHTML=""
    for(let i=1;i<=totalPages;i++){
        const btn=document.createElement("button")
        btn.textContent=i
        if(i===currentPage) btn.classList.add("active")
        btn.onclick=()=>{currentPage=i;showPhotos()}
        paginationDiv.appendChild(btn)
    }
}

document.addEventListener("click", e=>{
    if(e.target.classList.contains("toggle-info")){
        const info = e.target.previousElementSibling
        const open = info.style.display==="block"
        info.style.display = open ? "none":"block"
        e.target.textContent = open ? "Voir détails":"Réduire"
    }
})

themeButtons.forEach(btn=>{
    btn.addEventListener("click",()=>{
        themeButtons.forEach(b=>b.classList.remove("active"))
        btn.classList.add("active")
        currentTheme = btn.dataset.theme
        currentPage = 1
        showPhotos()
    })
})

const allThemesData = {{ allThemesJson|raw }}

function normalize(s){
    return (s||'').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'')
}

function searchTheme(){
    const query = normalize(searchInput.value.trim())
    if(!query){ searchMessage.style.display="none"; return }

    const pillMatch = themeButtons.find(btn=>normalize(btn.textContent.trim()).includes(query))
    if(pillMatch){
        themeButtons.forEach(b=>b.classList.remove("active"))
        pillMatch.classList.add("active")
        currentTheme = pillMatch.dataset.theme
        currentPage = 1
        searchMessage.style.display="none"
        showPhotos()
        return
    }

    const themeMatch = allThemesData.find(t=>normalize(t.nom).includes(query))
    if(themeMatch){
        themeButtons.forEach(b=>b.classList.remove("active"))
        currentTheme = themeMatch.id
        currentPage = 1
        searchMessage.style.display="none"
        showPhotos()
    }else{
        searchMessage.style.display="block"
    }
}

searchInput.addEventListener("keydown", e=>{if(e.key==="Enter") searchTheme()})
searchBtn.addEventListener("click", searchTheme)

showPhotos()
</script>

{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@700;900&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;background:#EEF2FF;color:#0F172A}

/* HEADER */
.site-header{position:fixed;top:0;left:0;right:0;height:68px;background:#fff;display:flex;align-items:center;gap:20px;padding:0 32px;box-shadow:0 1px 20px rgba(15,23,42,.06);z-index:1000}
.logo{font-size:1.5rem;font-weight:900;color:#7C3AED;letter-spacing:.1em;font-family:'Poppins',sans-serif;flex-shrink:0;display:flex;align-items:center;gap:8px}
.logo-dot{width:9px;height:9px;background:#7C3AED;border-radius:50%;box-shadow:0 0 8px rgba(124,58,237,.5);flex-shrink:0}

.header-search-wrap{flex:1;max-width:480px;margin:0 auto;position:relative}
.search-bar{display:flex;align-items:center;background:#F8FAFC;border:1.5px solid #E2E8F0;border-radius:50px;padding:0 6px 0 16px;transition:border-color .2s,box-shadow .2s}
.search-bar:focus-within{border-color:#7C3AED;box-shadow:0 0 0 3px rgba(124,58,237,.12)}
.search-ico{width:16px;height:16px;color:#94A3B8;flex-shrink:0}
#searchTheme{flex:1;border:none;background:transparent;outline:none;padding:10px 10px;font-size:.9rem;color:#0F172A;font-family:inherit}
#searchTheme::placeholder{color:#CBD5E1}
#searchBtn{padding:7px 16px;border:none;border-radius:50px;background:linear-gradient(135deg,#78c8eb,#7C3AED);color:#fff;font-size:.82rem;font-weight:600;cursor:pointer;white-space:nowrap;font-family:inherit}
#searchMessage{display:none;position:absolute;top:calc(100% + 6px);left:16px;font-size:.8rem;color:#EF4444;font-weight:500}

.header-nav{display:flex;align-items:center;gap:10px;flex-shrink:0}
.nav-btn{padding:8px 18px;border-radius:50px;font-weight:600;font-size:.88rem;text-decoration:none;transition:all .2s;white-space:nowrap}
.nav-primary{background:linear-gradient(135deg,#78c8eb,#7C3AED);color:#fff}
.nav-primary:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(124,58,237,.35)}
.nav-outline{background:transparent;color:#7C3AED;border:1.5px solid #7C3AED}
.nav-outline:hover{background:#7C3AED;color:#fff}

/* THEMES BAR */
.themes-bar{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;padding:88px 32px 20px}
.theme-pill{padding:8px 20px;border-radius:50px;border:1.5px solid #E2E8F0;background:#fff;font-size:.85rem;font-weight:500;color:#374151;cursor:pointer;transition:all .2s;font-family:inherit}
.theme-pill:hover{border-color:#7C3AED;color:#7C3AED}
.theme-pill.active{background:linear-gradient(135deg,#78c8eb,#7C3AED);color:#fff;border-color:transparent;font-weight:600}

/* MASONRY GRID */
#photo-grid{columns:4 230px;column-gap:16px;padding:8px 32px 80px}
.photo-card{break-inside:avoid;margin-bottom:16px;background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 2px 12px rgba(15,23,42,.07);transition:transform .25s,box-shadow .25s;display:block}
.photo-card:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(15,23,42,.12)}
.photo-wrapper{position:relative;overflow:hidden}
.photo-card img{width:100%;height:auto;display:block;min-height:80px;transition:transform .35s}
.photo-card:hover img{transform:scale(1.03)}
.overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(15,23,42,.7) 0%,transparent 50%);opacity:0;transition:opacity .3s;display:flex;align-items:flex-end;padding:14px}
.overlay p{color:#fff;font-size:.82rem;line-height:1.4;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.photo-card:hover .overlay{opacity:1}

.photo-caption{padding:10px 14px 6px}
.caption-desc{font-size:.85rem;font-weight:500;color:#1E293B;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.caption-author{font-size:.75rem;color:#94A3B8;margin-top:2px;display:block}

.photo-info{padding:10px 14px;background:#F8FAFC;border-top:1px solid #F1F5F9;font-size:.8rem;color:#374151;line-height:1.7}
.photo-info p{margin:0}
.photo-info strong{color:#0F172A}

.toggle-info{width:100%;padding:9px;border:none;border-top:1px solid #F1F5F9;background:transparent;color:#7C3AED;font-weight:600;font-size:.82rem;cursor:pointer;transition:background .2s;font-family:inherit}
.toggle-info:hover{background:#EEF2FF}

/* PAGINATION */
#pagination{text-align:center;padding:10px 0 60px;display:flex;justify-content:center;gap:6px;flex-wrap:wrap}
#pagination button{width:36px;height:36px;border:1.5px solid #E2E8F0;border-radius:8px;background:#fff;font-size:.88rem;cursor:pointer;transition:all .2s;font-family:inherit;color:#374151}
#pagination button:hover{border-color:#7C3AED;color:#7C3AED}
#pagination button.active{background:linear-gradient(135deg,#78c8eb,#7C3AED);color:#fff;border-color:transparent;font-weight:700}

@media(max-width:900px){
    .site-header{padding:0 16px}
    #photo-grid{columns:3 180px;padding:8px 16px 60px}
    .themes-bar{padding-top:88px;padding-left:16px;padding-right:16px}
}
@media(max-width:600px){
    .header-search-wrap{display:none}
    #photo-grid{columns:2 140px}
    .nav-btn{padding:7px 12px;font-size:.8rem}
}
</style>
{% endblock %}
