{% extends 'base.html.twig' %}
{% block title %}Album — {{ album.categorie }}{% endblock %}

{% block body %}

<header class="app-header">
    <a href="{{ path('app_welcome') }}" class="back-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
        Retour
    </a>
    <div class="album-title">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M3 9h18M9 21V9"/></svg>
        {{ album.categorie }}
    </div>
    <span class="photo-count">{{ photos|length }} photo{{ photos|length > 1 ? 's' : '' }}</span>
</header>

<div class="page-content">
    {% if photos is empty %}
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <p>Aucune photo dans cet album</p>
            <a href="{{ path('app_welcome') }}" class="back-link">Retourner à mes photos</a>
        </div>
    {% else %}
        <div class="photo-grid">
            {% for photo in photos %}
            <div class="photo-card">
                <div class="photo-img-wrap">
                    <img src="/uploads/photos/{{ photo.photoUrl }}" alt="{{ photo.description }}" loading="lazy">
                    <div class="photo-hover">
                        <form action="{{ path('app_delete_photo', {'id': photo.id}) }}" method="POST"
                              onsubmit="return confirm('Supprimer cette photo de l\'album ?');">
                            <button type="submit" class="delete-btn">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                Supprimer
                            </button>
                        </form>
                    </div>
                </div>
                {% if photo.description %}
                <p class="photo-desc">{{ photo.description }}</p>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@700;900&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;background:#F8FAFC;color:#0F172A}

.app-header{position:fixed;top:0;left:0;right:0;height:64px;background:#fff;display:flex;align-items:center;gap:16px;padding:0 28px;box-shadow:0 1px 20px rgba(15,23,42,.06);z-index:100}
.back-btn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:8px;background:#F1F5F9;color:#374151;font-size:.85rem;font-weight:600;text-decoration:none;transition:background .2s}
.back-btn svg{width:16px;height:16px}
.back-btn:hover{background:#E2E8F0}
.album-title{display:flex;align-items:center;gap:8px;font-size:1.1rem;font-weight:800;color:#0F172A;flex:1}
.album-title svg{width:20px;height:20px;color:#7C3AED}
.photo-count{font-size:.82rem;color:#94A3B8;font-weight:500}

.page-content{padding:84px 28px 60px}

.photo-grid{columns:4 220px;column-gap:16px}
.photo-card{break-inside:avoid;margin-bottom:16px;background:#fff;border-radius:14px;overflow:hidden;box-shadow:0 2px 12px rgba(15,23,42,.07);transition:transform .25s,box-shadow .25s}
.photo-card:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(15,23,42,.12)}

.photo-img-wrap{position:relative;overflow:hidden}
.photo-card img{width:100%;height:auto;display:block;min-height:80px;transition:transform .3s}
.photo-card:hover img{transform:scale(1.04)}

.photo-hover{position:absolute;inset:0;background:rgba(15,23,42,.45);opacity:0;transition:opacity .25s;display:flex;align-items:center;justify-content:center}
.photo-card:hover .photo-hover{opacity:1}

.delete-btn{display:inline-flex;align-items:center;gap:7px;padding:9px 18px;border:2px solid #fff;border-radius:50px;background:transparent;color:#fff;font-size:.83rem;font-weight:600;cursor:pointer;transition:all .2s;font-family:inherit}
.delete-btn svg{width:15px;height:15px}
.delete-btn:hover{background:#EF4444;border-color:#EF4444}

.photo-desc{padding:8px 12px;font-size:.82rem;color:#374151;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.empty-state{text-align:center;padding:100px 24px;color:#94A3B8}
.empty-state svg{width:60px;height:60px;margin:0 auto 16px;display:block}
.empty-state p{font-size:1rem;margin-bottom:16px}
.back-link{color:#7C3AED;font-weight:600;font-size:.9rem;text-decoration:none}
.back-link:hover{text-decoration:underline}

@media(max-width:900px){.photo-grid{columns:3 160px}}
@media(max-width:600px){.photo-grid{columns:2 130px}.app-header{padding:0 16px}.page-content{padding:80px 16px 40px}}
</style>
{% endblock %}
